# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Email Service Configuration
# Choose provider: 'resend' or 'sendgrid'
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@amtmti.africa
COMPANY_EMAIL=admissions@amtmti.africa

# Resend API (if using Resend)
RESEND_API_KEY=re_your_resend_api_key

# SendGrid API (if using SendGrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# AMTMTI Email
NEXT_PUBLIC_AMTMTI_EMAIL=admissions@amtmti.africa

# Analytics (Optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_vercel_analytics_id
